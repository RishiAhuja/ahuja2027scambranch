#!/bin/bash
#PBS -N scmeval
#PBS -q workq
#PBS -l select=1:ncpus=1:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o scmeval.log
# GPU eval. Submit with CUDA_VISIBLE_DEVICES set to a free MIG UUID.
set -euo pipefail
cd "${PBS_O_WORKDIR:?qsub from the repository root}"
if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  echo "ERROR: CUDA_VISIBLE_DEVICES is empty" >&2
  exit 1
fi
export PYTHONNOUSERSITE=1
if [[ -f "$PBS_O_WORKDIR/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$PBS_O_WORKDIR/.env"
  set +a
fi
export HF_HOME="$PBS_O_WORKDIR/hf_cache"
export TRANSFORMERS_CACHE="$HF_HOME"
export HUGGING_FACE_HUB_TOKEN="${HUGGING_FACE_HUB_TOKEN:-${HF_TOKEN:-}}"
mkdir -p "$HF_HOME" results/eval_hpc
echo "=== scmeval start $(date -Is) host=$(hostname) ==="
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
nvidia-smi -L || true
source .venv/bin/activate
if [[ -n "${HF_TOKEN:-}" ]]; then
  echo "HF_TOKEN is set (not printed)"
else
  echo "WARNING: HF_TOKEN unset; gated models will skip"
fi
python -c 'import torch; print(torch.cuda.get_device_name(0)); assert torch.cuda.is_available()'
export PYTHONPATH="$PBS_O_WORKDIR/src"
python scripts/eval_detectors.py \
  --eval-run-id eval_hpc \
  --run-dir runs/full_v1 \
  --out-dir results/eval_hpc \
  --device cuda \
  --dtype bf16 \
  --views FULL PREFIX_ONLY PREFIX_PLUS_REACTION STREAMING
echo "=== scmeval done $(date -Is) ==="
