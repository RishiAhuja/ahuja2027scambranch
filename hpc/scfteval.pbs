#!/bin/bash
#PBS -N scfteval
#PBS -q workq
#PBS -l select=1:ncpus=1:ngpus=1
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o scfteval.log
# Eval all LoRA adapters then write FT_SUMMARY.md.
set -euo pipefail
cd "${PBS_O_WORKDIR:?qsub from the repository root}"
if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  echo "ERROR: CUDA_VISIBLE_DEVICES is empty" >&2
  exit 1
fi
export PYTHONNOUSERSITE=1
if [[ -f "$PBS_O_WORKDIR/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$PBS_O_WORKDIR/.env"
  set +a
fi
export HF_HOME="$PBS_O_WORKDIR/hf_cache"
export TRANSFORMERS_CACHE="$HF_HOME"
export HUGGING_FACE_HUB_TOKEN="${HUGGING_FACE_HUB_TOKEN:-${HF_TOKEN:-}}"
mkdir -p "$HF_HOME" results/eval_hpc_ft
echo "=== scfteval start $(date -Is) host=$(hostname) ==="
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
nvidia-smi -L || true
source .venv/bin/activate
python -c 'import torch, peft; print(torch.cuda.get_device_name(0), peft.__version__); assert torch.cuda.is_available()'
export PYTHONPATH="$PBS_O_WORKDIR/src"

# Discover adapters: outputs/ft/<model>/<arm>/seed<k>/adapter
mapfile -t ADAPTERS < <(
  find outputs/ft -type f -name adapter_config.json 2>/dev/null \
    | sed 's|/adapter_config.json||' \
    | sort
)
if [[ ${#ADAPTERS[@]} -eq 0 ]]; then
  echo "ERROR: no adapters found under outputs/ft" >&2
  exit 1
fi
MODELS=()
for ADIR in "${ADAPTERS[@]}"; do
  # path: outputs/ft/<short>/<arm>/seedK[/adapter]
  REL="${ADIR#outputs/ft/}"
  SHORT="${REL%%/*}"
  MODELS+=("${SHORT}@${ADIR}")
done
echo "Evaluating ${#MODELS[@]} adapters:"
printf '  %s\n' "${MODELS[@]}"

python scripts/eval_detectors.py \
  --eval-run-id eval_hpc_ft \
  --run-dir runs/full_v1 \
  --out-dir results/eval_hpc_ft \
  --device cuda \
  --dtype bf16 \
  --views FULL PREFIX_ONLY PREFIX_PLUS_REACTION CALLER_ONLY \
  --models "${MODELS[@]}"

python scripts/summarize_ft.py \
  --metrics results/eval_hpc_ft/metrics.json \
  --out results/eval_hpc_ft/FT_SUMMARY.md
echo "=== scfteval done $(date -Is) ==="
